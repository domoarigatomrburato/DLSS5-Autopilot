# Build tools of the release workflow, pinned. Regenerate the hashed file
# after changing this one (from the repository root):
#   uv pip compile .github/release-requirements.in --generate-hashes --python-version 3.12 --python-platform windows --no-header -o .github/release-requirements.txt
# Upgrade a pin by editing its version here, then regenerate and review the
# diff of the .txt: a new version brings its hashes with it.
pyinstaller==6.22.3
# The root-certificate bundle the exe carries (net.ssl_context).
certifi==2026.11.20
# PyInstaller's sdist is built with hatchling. The source build runs with
# --no-build-isolation (see release.yml), so the build backend is pinned and
# hashed here with everything else instead of being fetched unhashed.
hatchling==1.33.0
