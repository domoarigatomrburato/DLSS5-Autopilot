<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage counts our own code: sources generated under obj/ (logging, XAML) are not ours. -->
<Configuration>
  <CodeCoverage>
    <Sources>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
